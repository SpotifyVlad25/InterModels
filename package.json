{
  "name": "intermodels",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create intermodels-db",
    "db:migrate:local": "wrangler d1 migrations apply intermodels-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply intermodels-db --remote",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20261117.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.45.0"
  }
}
